<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gesture_settings"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/single_finger"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/singleFingerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioFingerIgnored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finger_ignored"
            android:textColor="?attr/colorOnSurface" />

        <RadioButton
            android:id="@+id/radioFingerDraw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finger_draw"
            android:textColor="?attr/colorOnSurface" />

        <RadioButton
            android:id="@+id/radioFingerScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finger_scroll"
            android:textColor="?attr/colorOnSurface" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginVertical="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gesture_two_finger_note"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

</LinearLayout>