<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notebookCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/notebookThumbCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/notebookPreviewImageView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/notebook_preview"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_thumb_skeleton"
                    app:layout_constraintDimensionRatio="1:1.41"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/notebookTagView"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:elevation="4dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_color_slot"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/notebookPreviewImageView"
                    app:layout_constraintStart_toStartOf="@id/notebookPreviewImageView" />

                <ImageView
                    android:id="@+id/notebookSelectCheck"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:elevation="4dp"
                    android:layout_margin="8dp"
                    android:padding="5dp"
                    android:background="@drawable/bg_select_check_circle"
                    android:src="@drawable/ic_check"
                    android:tint="?attr/colorOnPrimary"
                    android:contentDescription="Selected"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/notebookPreviewImageView"
                    app:layout_constraintEnd_toEndOf="@id/notebookPreviewImageView" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/notebookPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="20dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="100dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <com.lochan.octopusnotes.MarqueeTextView
                    android:id="@+id/notebookNameTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Notebook Name"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/notebookMenuButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="Options"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

</LinearLayout>
