<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/table_structure_title"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="8dp" />

    <com.lochan.octopusnotes.TableGridPreviewView
        android:id="@+id/tableStructurePreview"
        android:layout_width="132dp"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/tableRowSizeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/tableRowMinus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_remove"
            android:contentDescription="@string/table_row_size_decrease"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableRowSizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/tableRowPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/table_row_size_increase"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView
            android:id="@+id/tableColSizeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/tableColMinus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_remove"
            android:contentDescription="@string/table_col_size_decrease"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableColSizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/tableColPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/table_col_size_increase"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginVertical="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/table_structure_hint"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tableAddRowAbove"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_add_row_above"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableAddRowBelow"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_add_row_below"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tableAddColLeft"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_add_col_left"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableAddColRight"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_add_col_right"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">
        <TextView
            android:id="@+id/tableDeleteRow"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_delete_row"
            android:textColor="?attr/colorError"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableDeleteCol"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_delete_column"
            android:textColor="?attr/colorError"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginVertical="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:id="@+id/tableMergeRight"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_merge_right"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableMergeDown"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_merge_down"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tableSplitCell"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/table_split_cell"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
