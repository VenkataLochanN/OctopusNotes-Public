<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawingRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdf_surround"
    tools:context=".DrawingActivity">

    <com.lochan.octopusnotes.ZoomableRecyclerView
        android:id="@+id/pdfRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.lochan.octopusnotes.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/pdfLoadingOverlay"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/topBarStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/nav_back"
            android:tint="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/pagesButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="11dp" android:scaleType="centerInside"
            android:src="@drawable/ic_grid"
            android:contentDescription="@string/pages_overview"
            android:tint="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/undoButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_undo"
            android:contentDescription="Undo"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="@drawable/selectable_tool_background"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/redoButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_redo"
            android:contentDescription="Redo"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="@drawable/selectable_tool_background"
            android:foreground="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topBarEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/addPageButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/add_page"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search_pdf"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/overflowButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/overflow_menu"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Top-centre dock: tools row, plus (when Pen active) a second row of tool options -->
    <LinearLayout
        android:id="@+id/toolDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:animateLayoutChanges="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@id/topBarStart"
        app:layout_constraintEnd_toStartOf="@id/topBarEnd"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tools group: collapse (small only) + tool buttons (scrollable in both layouts) -->
        <LinearLayout
            android:id="@+id/toolsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/dockCollapseButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/arrow_back_ios_24px"
                android:contentDescription="Collapse toolbar"
                android:tint="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <HorizontalScrollView
                android:id="@+id/toolsScrollH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/toolDockItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

            <ImageButton
                android:id="@+id/penButton"
                android:layout_width="48dp" android:layout_height="48dp"
                android:padding="10dp" android:scaleType="centerInside"
                android:src="@drawable/ic_pen"
                android:contentDescription="@string/tool_pen"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="@drawable/selectable_tool_background"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/eraserButton"
                android:layout_width="48dp" android:layout_height="48dp"
                android:padding="10dp" android:scaleType="centerInside"
                android:src="@drawable/ic_eraser"
                android:contentDescription="@string/tool_eraser"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="@drawable/selectable_tool_background"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/selectionButton"
                android:layout_width="48dp" android:layout_height="48dp"
                android:padding="10dp" android:scaleType="centerInside"
                android:src="@drawable/ic_lasso"
                android:contentDescription="@string/tool_lasso"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="@drawable/selectable_tool_background"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/highlighterButton"
                android:layout_width="48dp" android:layout_height="48dp"
                android:padding="10dp" android:scaleType="centerInside"
                android:src="@drawable/ic_highlighter"
                android:contentDescription="Highlighter"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="@drawable/selectable_tool_background"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="48dp" android:layout_height="48dp"
                android:padding="10dp" android:scaleType="centerInside"
                android:src="@drawable/ic_image"
                android:contentDescription="Insert image"
                android:tint="?attr/colorOnSurfaceVariant"
                android:background="@drawable/selectable_tool_background"
                android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Tools vertical scroll (small screens; toolDockItems re-parented here at runtime) -->
            <ScrollView
                android:id="@+id/toolsScrollV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:scrollbars="none"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Options (large: horizontal scroll). On small the row is re-parented into optionsScrollV. -->
        <HorizontalScrollView
            android:id="@+id/optionsScrollH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/optionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/penPropsStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                <ImageButton
                    android:id="@+id/lineStyleButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="9dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_line_solid"
                    android:contentDescription="Line style"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <View android:id="@+id/colorSwatch0"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/colorSwatch1"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/colorSwatch2"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/colorSwatch3"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/colorSwatch4"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <ImageButton
                    android:id="@+id/thinButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_thin"
                    android:contentDescription="Thin"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/mediumButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_medium"
                    android:contentDescription="Medium"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/thickButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_thick"
                    android:contentDescription="Thick"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/eraserPropsStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                <TextView
                    android:id="@+id/eraserPixelButton"
                    android:layout_width="wrap_content" android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Pixel"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/eraserStrokeButton"
                    android:layout_width="wrap_content" android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Stroke"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="?attr/colorOutlineVariant" />

                <ImageButton
                    android:id="@+id/eraserSize0"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_thin"
                    android:contentDescription="Small eraser"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/eraserSize1"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_medium"
                    android:contentDescription="Medium eraser"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/eraserSize2"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_thick"
                    android:contentDescription="Large eraser"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/highlighterPropsStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                <ImageButton
                    android:id="@+id/hlShapeButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="9dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_line_wavy"
                    android:contentDescription="Highlighter shape and mode"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <View android:id="@+id/hlColor0"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/hlColor1"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/hlColor2"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/hlColor3"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />
                <View android:id="@+id/hlColor4"
                    android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_color_slot" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <ImageButton
                    android:id="@+id/hlSize0"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_thin"
                    android:contentDescription="Thin highlighter"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/hlSize1"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_medium"
                    android:contentDescription="Medium highlighter"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/hlSize2"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_stroke_thick"
                    android:contentDescription="Thick highlighter"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lassoPropsStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                <ImageButton
                    android:id="@+id/lassoFreeButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="9dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_lasso"
                    android:contentDescription="Free selection"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/lassoRectButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_select_rect"
                    android:contentDescription="Rectangular selection"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                <ImageButton
                    android:id="@+id/lassoCircleButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_select_circle"
                    android:contentDescription="Circular selection"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/imagePropsStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                <!-- Shown while photo access hasn't been granted -->
                <LinearLayout
                    android:id="@+id/imagePermissionGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="No photo access"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/imageGrantButton"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Allow"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:background="@drawable/selectable_tool_background"
                        android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/imagePickButton"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Browse images"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/selectable_tool_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone" />

                <View
                    android:id="@+id/imageStripDivider"
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/colorOutlineVariant"
                    android:visibility="gone" />

                <!-- Recent image previews, filled at runtime -->
                <LinearLayout
                    android:id="@+id/imageRecentsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Options vertical scroll (small screens; optionsRow re-parented here at runtime) -->
        <ScrollView
            android:id="@+id/optionsScrollV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scrollbars="none"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/bg_toolbar_pill"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintWidth_max="400dp"
        app:layout_constraintEnd_toEndOf="@id/topBarEnd"
        app:layout_constraintTop_toBottomOf="@id/toolDock">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:background="@null"
            android:hint="@string/search_hint" android:imeOptions="actionSearch"
            android:inputType="text" android:maxLines="1"
            android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton android:id="@+id/searchDropdown"
            android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp"
            android:src="@drawable/ic_arrow_drop_down" android:contentDescription="Show results"
            android:tint="?attr/colorOnSurfaceVariant" android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView android:id="@+id/searchCount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />

        <ImageButton android:id="@+id/searchPrev"
            android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:src="@drawable/arrow_back_ios_24px" android:contentDescription="@string/search_prev"
            android:tint="?attr/colorOnSurfaceVariant" android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton android:id="@+id/searchNext"
            android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:src="@drawable/arrow_forward_ios_24px" android:contentDescription="@string/search_next"
            android:tint="?attr/colorOnSurfaceVariant" android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton android:id="@+id/searchClose"
            android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:src="@drawable/ic_close" android:contentDescription="@string/search_close"
            android:tint="?attr/colorOnSurfaceVariant" android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <TextView
        android:id="@+id/pageNumberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        tools:text="1 / 1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Zoom % pill, sits just above the page indicator -->
    <TextView
        android:id="@+id/zoomIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="150%"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/pageNumberTextView"
        app:layout_constraintStart_toStartOf="@id/pageNumberTextView" />

    <TextView
        android:id="@+id/searchProgressPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Searching pages…  3 / 120"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Outline loading pill (shown briefly while background scan runs) -->
    <TextView
        android:id="@+id/outlineLoadingPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_toolbar_pill"
        android:elevation="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="Searching for outlines…"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scroll pill track (invisible touch/positioning area on the right edge) -->
    <View
        android:id="@+id/scrollPillTrack"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBarEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll pill thumb (draggable indicator) -->
    <ImageView
        android:id="@+id/scrollPillThumb"
        android:layout_width="32dp"
        android:layout_height="64dp"
        android:alpha="0.6"
        android:background="@drawable/bg_scroll_pill"
        android:src="@drawable/ic_drag_indicator"
        android:scaleType="center"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="@id/scrollPillTrack"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>