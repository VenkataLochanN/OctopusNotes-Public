<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="220dp"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView android:id="@+id/bsRename" style="@style/AddPageRowTitle" android:layout_width="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:text="Rename" android:drawablePadding="16dp" android:drawableStart="@drawable/ic_pen"/>
    <TextView android:id="@+id/bsLock" style="@style/AddPageRowTitle" android:layout_width="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:text="Lock Note" android:drawablePadding="16dp" android:drawableStart="@drawable/ic_close"/>
    <TextView android:id="@+id/bsFav" style="@style/AddPageRowTitle" android:layout_width="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:text="Add to Favorites" android:drawablePadding="16dp" android:drawableStart="@drawable/ic_color"/>
    <TextView android:id="@+id/bsMove" style="@style/AddPageRowTitle" android:layout_width="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:text="Move to" android:drawablePadding="16dp" android:drawableStart="@drawable/ic_folder"/>
    <TextView android:id="@+id/bsDuplicate" style="@style/AddPageRowTitle" android:layout_width="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:text="Duplicate" android:drawablePadding="16dp" android:drawableStart="@drawable/ic_duplicate"/>
    <TextView android:id="@+id/bsDelete" style="@style/AddPageRowTitle" android:layout_width="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingHorizontal="20dp" android:paddingVertical="14dp" android:text="Delete" android:textColor="#F44336" android:drawablePadding="16dp" android:drawableStart="@drawable/ic_eraser"/>
</LinearLayout>
