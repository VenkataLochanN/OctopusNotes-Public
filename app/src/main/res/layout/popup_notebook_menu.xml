<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="216dp"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_popup_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_popup_icon"
            android:padding="8dp">
            <ImageView
                android:id="@+id/popupHeaderIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/ic_notes"
                android:tint="?attr/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/popupTitle"
                style="@style/PopupMenuTitle" />

            <TextView
                android:id="@+id/popupMeta"
                style="@style/PopupMenuMeta"
                android:text="Your notes" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/PopupMenuSectionLabel"
        android:text="MANAGE" />

    <TextView
        android:id="@+id/bsRename"
        style="@style/PopupMenuRow"
        android:drawableStart="@drawable/ic_pen"
        android:text="Rename" />

    <TextView
        android:id="@+id/bsLock"
        style="@style/PopupMenuRow"
        android:drawableStart="@drawable/ic_lock"
        android:text="Lock Note" />

    <TextView
        style="@style/PopupMenuSectionLabel"
        android:text="ORGANIZE" />

    <TextView
        android:id="@+id/bsFav"
        style="@style/PopupMenuRow"
        android:drawableStart="@drawable/ic_star"
        android:text="Add to Favorites" />

    <TextView
        android:id="@+id/bsTag"
        style="@style/PopupMenuRow"
        android:drawableStart="@drawable/ic_tag"
        android:text="Add Tag" />

    <TextView
        android:id="@+id/bsMove"
        style="@style/PopupMenuRow"
        android:drawableStart="@drawable/ic_folder"
        android:text="Move to" />

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/bsDuplicate"
        style="@style/PopupMenuRow"
        android:drawableStart="@drawable/ic_duplicate"
        android:text="Duplicate" />

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/bsDelete"
        style="@style/PopupMenuRowDestructive"
        android:drawableStart="@drawable/ic_delete"
        android:text="Delete" />
</LinearLayout>
