<?xml version="1.0" encoding="utf-8"?>
<!--
  Flip vertical: solid top half, dashed bottom half, split by a centre line.
  Same geometry as ic_flip_horizontal turned a quarter turn — the rotation is done with
  a group so the paths stay identical to the horizontal version and the two icons can be
  edited in step, rather than keeping a hand-rotated (and easily divergent) copy.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="90">

        <!-- Centre axis the shape mirrors about -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11,1h2v22h-2z" />

        <!-- Solid half -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M3,5v14c0,1.1 0.9,2 2,2h4v-2H5V5h4V3H5C3.9,3 3,3.9 3,5z" />

        <!-- Mirrored half, drawn as dashes to read as the reflection -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M15,5h2V3h-2V5zM19,9h2V7h-2V9zM19,13h2v-2h-2V13zM19,17h2v-2h-2V17zM15,21h2v-2h-2V21zM19,21c1.1,0 2,-0.9 2,-2h-2V21zM19,3v2h2C21,3.9 20.1,3 19,3z" />
    </group>
</vector>
