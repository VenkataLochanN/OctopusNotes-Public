    <string name="intro_welcome_title">Welcome to %1$s</string>
    <string name="intro_welcome_subtitle">This quick intro shows what %1$s can do.</string>
    <string name="intro_welcome_sentence">Your notes stay offline &amp; private. No ads, no telemetry and the app is free &amp; open source.</string>

    <string name="intro_tools_title">Meet the tools</string>
    <string name="intro_tools_title_with_tool">Meet the %1$s tool</string>
    <string name="intro_tools_subtitle">Tap a tool, then tap an option to see what it does.</string>
    <string name="intro_tools_highlighter">Highlighter</string>
    <string name="intro_tools_image">Image</string>

    <string name="intro_tool_pen_options_1_desc">Choose solid, dotted, dashed or wavy strokes.</string>
    <string name="intro_tool_pen_options_2_desc">Five custom colours. Tap one to use it, tap it again to edit it.</string>
    <string name="intro_tool_pen_options_3_desc">Three thickness slots. Tap to use, tap again to fine-tune the size.</string>

    <string name="intro_tool_eraser_pixel">Pixel</string>
    <string name="intro_tool_eraser_stroke">Stroke</string>
    <string name="intro_tool_eraser_options_1_desc">Pixel eraser rubs out exactly what you move over; stroke eraser removes whole strokes at once.</string>
    <string name="intro_tool_eraser_options_2_desc">Three custom eraser sizes, from a fine tip to a wide sweep.</string>

    <string name="intro_tool_highlighter_options_1_desc">Straight or freehand highlight shapes and modes.</string>
    <string name="intro_tool_highlighter_options_2_desc">Five highlight colours: yellow, green, pink, blue and orange, each editable.</string>
    <string name="intro_tool_highlighter_options_3_desc">Three sizes, from a fine underline to a broad sweep.</string>

    <string name="intro_tool_lasso_options_1_desc">Free, rectangular or circular selection. Then move, resize, rotate, recolour, duplicate, delete, flip, copy, cut and paste.</string>

    <string name="intro_tool_shape_options_1_desc">Rectangle, oval, triangle, line or arrow.</string>
    <string name="intro_tool_shape_options_2_desc">Choose the shape\'s size, colour and thickness.</string>

    <string name="intro_tool_table_options_1_desc">Solid, dotted, dashed or wavy table borders.</string>
    <string name="intro_tool_table_options_2_desc">Draw the table area, pick rows and columns, then add header rows, cell colours, rounded corners and editable cell text, with a live preview.</string>
    <string name="intro_tool_table_options_3_desc">Thin, medium or thick table borders.</string>

    <string name="intro_tool_laser_options_1_desc">The laser trail\'s colour.</string>
    <string name="intro_tool_laser_options_2_desc">The laser trail\'s size. The trail fades away after a moment.</string>

    <string name="intro_tool_text_options_1_desc">Small, medium or large text. Tap the page and type anywhere; move or resize it afterwards.</string>

    <string name="intro_tool_image_options_1_desc">Take a photo with the camera.</string>
    <string name="intro_tool_image_options_2_desc">Pick from your gallery or recent photos. Crop and rotate before placing.</string>

    <string name="undo">Undo</string>
    <string name="redo">Redo</string>
    <string name="intro_tools_undo_footer">Undo &amp; redo every change</string>

    <string name="intro_popup_line_styles">Solid: one continuous line. Dotted: evenly spaced dots. Dashed: short dashes.</string>
    <string name="intro_popup_stabilization">Stabilization smooths your strokes. Higher levels smooth more.</string>
    <string name="intro_popup_thickness">Drag the slider or tap the − and + buttons to set the stroke size.</string>
    <string name="intro_popup_hl_shape">Free follows your hand; Straight snaps to a perfectly straight line.</string>
    <string name="intro_popup_hl_mode">Normal highlights over the page; Text highlights only text when text is detected. Else, it will work like the normal one.</string>
    <string name="intro_line_style_solid">Solid</string>
    <string name="intro_line_style_dotted">Dotted</string>
    <string name="intro_line_style_dashed">Dashed</string>

    <string name="intro_editing_title">Editing</string>
    <string name="intro_editing_subtitle">How you write and draw. Turn each option on or off.</string>
    <string name="intro_editing_row_pages">Add pages continuously</string>
    <string name="intro_editing_row_pages_desc">When you write on the last page, a new page is added automatically, so there\'s no need to tap the + button.</string>
    <string name="intro_editing_row_options">Show tool options</string>
    <string name="intro_editing_row_options_desc">A tool\'s options appear automatically when you switch to it. Turn this off to keep them closed until you tap the tool button.</string>
    <string name="intro_editing_row_tabs">Tabs mode</string>
    <string name="intro_editing_row_tabs_desc">Switch between open notes from a tab strip above the toolbar, like browser tabs. Tap the title to see all open notes.</string>
    <string name="intro_editing_row_canvas">Canvas color</string>
    <string name="intro_editing_row_canvas_desc">The colour behind your pages. It matches your wallpaper by default (Material You), and you can pick any colour you like.</string>
    <string name="intro_editing_row_scribble">Scribble to erase</string>
    <string name="intro_editing_scribble_easy">Easy</string>
    <string name="intro_editing_scribble_hard">Hard</string>
    <string name="intro_editing_row_canvas_default">Default</string>
    <string name="intro_editing_row_scribble_desc">Scribble back and forth over ink with the pen to erase it. Easy needs only a few passes; hard needs a denser scribble, so accidental wiggles are less likely to erase.</string>

